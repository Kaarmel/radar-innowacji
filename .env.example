# Klucz OpenRouter (model DeepSeek). Bez klucza filtry AI dostają „brak danych”, reszta działa.
OPENROUTER_API_KEY=
# Darmowy klucz OpenAlex (publikacje naukowe na żądanie). Bez klucza źródło jest pomijane.
OPENALEX_API_KEY=
# Opcjonalnie: inna ścieżka bazy SQLite (np. osobna kopia dla zestawu testowego)
# RADAR_BAZA=dane/walidacja.sqlite
# Opcjonalnie: inny model z OpenRouter
# MODEL=deepseek/deepseek-v4.1-flash
# Ścieżka B: model lokalny przez API zgodne z OpenAI (Ollama, vLLM, LM Studio)
# AI_URL=http://127.0.0.1:11434/v1/chat/completions
# MODEL=qwen3:8b
# AI_API_KEY=
